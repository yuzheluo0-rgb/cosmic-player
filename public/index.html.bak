});

// Comets with glow head
const cometGlowTex=glowTex('rgba(150,220,255,1)','rgba(30,80,255,0.5)');
const comets=[],meteors=[];
function newComet(){
  // Glowing head
  const hG=new THREE.SphereGeometry(0.06,8,8);
  const h=new THREE.Mesh(hG,new THREE.MeshBasicMaterial({color:0xaaddff,transparent:true,opacity:0.9,depthWrite:false}));
  // Trail
  const g=new THREE.BufferGeometry();const p=new Float32Array(80*3);const c=new Float32Array(80*3);
  for(let i=0;i<80;i++){p[i*3]=i*0.05;const cl=new THREE.Color().setHSL(0.55+Math.random()*0.12,0.6,0.25+(1-i/80)*0.75);c[i*3]=cl.r;c[i*3+1]=cl.g;c[i*3+2]=cl.b}
  g.setAttribute('position',new THREE.BufferAttribute(p,3));g.setAttribute('color',new THREE.BufferAttribute(c,3));
  const trail=new THREE.Line(g,new THREE.LineBasicMaterial({vertexColors:true,blending:THREE.AdditiveBlending,depthWrite:false}));
  // Group
  const grp=new THREE.Group();grp.add(h);grp.add(trail);
  grp.position.set((Math.random()-0.5)*20,(Math.random()-0.5)*12,(Math.random()-0.5)*8);
  grp.rotation.set(Math.random()*0.3,Math.random()*Math.PI*2,0);
  grp.userData={sp:0.1+Math.random()*0.2,life:0,ml:200+Math.random()*300,head:h};
  sS.add(grp);comets.push(grp);
  if(comets.length>6){const o=comets.shift();sS.remove(o);o.traverse(c=>{if(c.geometry)c.geometry.dispose();if(c.material)c.material.dispose()})}
}
function newMeteor(){
  const g=new THREE.BufferGeometry();const p=new Float32Array(20*3);const c=new Float32Array(20*3);
  for(let i=0;i<20;i++){p[i*3]=i*0.04;const cl=new THREE.Color().setHSL(0.1,0.35,(1-i/20)*0.85);c[i*3]=cl.r;c[i*3+1]=cl.g;c[i*3+2]=cl.b}
  g.setAttribute('position',new THREE.BufferAttribute(p,3));g.setAttribute('color',new THREE.BufferAttribute(c,3));
  const m=new THREE.Line(g,new THREE.LineBasicMaterial({vertexColors:true,blending:THREE.AdditiveBlending,depthWrite:false}));
  m.position.set((Math.random()-0.5)*16,3+Math.random()*8,(Math.random()-0.5)*6);
  m.rotation.z=Math.PI*0.65+Math.random()*0.25;
  m.userData={sp:0.2+Math.random()*0.4,life:0,ml:35+Math.random()*70};
  sS.add(m);meteors.push(m);
  if(meteors.length>12){const o=meteors.shift();sS.remove(o);o.geometry.dispose();o.material.dispose()}
}
