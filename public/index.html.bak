<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🌌 COSMIC PLAYER</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Noto Sans SC','Orbitron',sans-serif;background:#000;overflow:hidden;height:100vh;color:#e0f0ff;user-select:none}
canvas#bg{position:fixed;top:0;left:0;z-index:0}
#app{position:relative;z-index:1;height:100vh;display:flex;flex-direction:column;pointer-events:none}
#app>*{pointer-events:auto}
#topbar{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;background:linear-gradient(180deg,rgba(3,8,25,0.9) 0%,rgba(3,8,25,0) 100%)}
.logo{font-family:'Orbitron';font-size:1.1rem;font-weight:900;background:linear-gradient(135deg,#00d4ff,#7b2fff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:2px}
#userBtn{cursor:pointer;padding:5px 14px;border:1px solid rgba(0,212,255,0.4);border-radius:18px;font-size:.78rem;color:#00d4ff;background:rgba(0,20,50,0.5);transition:all .3s}
#userBtn:hover{border-color:#00d4ff;box-shadow:0 0 16px rgba(0,212,255,0.2)}
#main{flex:1;display:flex;gap:12px;padding:0 12px;overflow:hidden}
.panel{background:rgba(3,8,25,0.65);backdrop-filter:blur(10px);border:1px solid rgba(0,212,255,0.1);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;position:relative}
.panel-header{padding:10px 14px;border-bottom:1px solid rgba(0,212,255,0.08);font-family:'Orbitron';font-size:.72rem;letter-spacing:2px;color:#00d4ff;display:flex;justify-content:space-between;align-items:center}
#leftPanel{width:300px;flex-shrink:0}
#leftPanel .panel-header .collapse-btn{cursor:pointer;font-size:.8rem;opacity:.6;transition:opacity .2s}
#leftPanel .panel-header .collapse-btn:hover{opacity:1}
#playlist{flex:1;overflow-y:auto;padding:4px}
#playlist::-webkit-scrollbar{width:3px}
#playlist::-webkit-scrollbar-thumb{background:rgba(0,212,255,0.2);border-radius:2px}
#searchBox{margin:6px;position:relative}
#searchBox input{width:100%;padding:9px 36px 9px 12px;background:rgba(3,8,20,0.6);border:1px solid rgba(0,212,255,0.12);border-radius:20px;color:#e0f0ff;font-size:.8rem;outline:none;transition:all .3s}
#searchBox input:focus{border-color:#00d4ff;box-shadow:0 0 15px rgba(0,212,255,0.12)}
#searchBox button{position:absolute;right:2px;top:2px;width:30px;height:30px;border-radius:50%;border:none;background:linear-gradient(135deg,#00d4ff,#7b2fff);color:#fff;font-size:.8rem;cursor:pointer}
#searchResults{position:absolute;top:42px;left:0;right:0;background:rgba(3,8,22,0.97);border:1px solid rgba(0,212,255,0.15);border-radius:10px;max-height:220px;overflow-y:auto;z-index:10;display:none}
.song-item{padding:8px 10px;margin:1px 0;border-radius:6px;cursor:pointer;display:flex;align-items:center;gap:8px;transition:all .15s;font-size:.76rem}
.song-item:hover{background:rgba(0,212,255,0.06)}
.song-item.active{background:rgba(0,212,255,0.12);border:1px solid rgba(0,212,255,0.15)}
.song-item .idx{width:16px;text-align:center;color:#446;font-family:'Orbitron';font-size:.6rem;flex-shrink:0}
.song-item.active .idx{color:#00d4ff}
.song-item .info{flex:1;min-width:0}
.song-item .name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.song-item .artist{font-size:.66rem;color:#778}
.song-item .del-btn{width:18px;height:18px;border-radius:50%;border:none;background:rgba(255,50,50,0.1);color:#f66;cursor:pointer;font-size:.55rem;opacity:0;transition:opacity .2s;flex-shrink:0;line-height:18px;text-align:center;padding:0}
.song-item:hover .del-btn{opacity:1}
.song-item .del-btn:hover{background:rgba(255,50,50,0.3)}

#rightPanel{flex:1;display:flex;flex-direction:column;gap:0}
#planetZone{flex:1;position:relative;min-height:180px}
#planetZone canvas{position:absolute;top:0;left:0;width:100%;height:100%}
#albumCard{position:absolute;right:14px;top:50%;transform:translateY(-50%);width:110px;aspect-ratio:1;border-radius:10px;overflow:hidden;border:1.5px solid rgba(0,212,255,0.2);box-shadow:0 0 25px rgba(0,212,255,0.1);z-index:5;background:rgba(3,8,22,0.7);display:flex;align-items:center;justify-content:center;font-size:2.5rem}
#albumCard img{width:100%;height:100%;object-fit:cover}
#albumCard .ph{opacity:.25}
#trackSection{text-align:center;padding:4px 16px 0}
#trackTitle{font-size:1rem;font-weight:700}
#trackArtist{color:#778;font-size:.75rem;margin-bottom:2px}

#starTrailWrap{padding:0 20px;position:relative}
#starTrailCanvas{width:100%;height:30px;border-radius:14px;cursor:pointer}
#trailTimes{display:flex;justify-content:space-between;padding:1px 22px 0;font-family:'Orbitron';font-size:.6rem;color:#556}

#controls{display:flex;align-items:center;justify-content:center;gap:12px;padding:4px 0 10px}
.ctrl-btn{width:36px;height:36px;border-radius:50%;border:1px solid rgba(0,212,255,0.15);background:rgba(3,8,22,0.5);color:#00d4ff;font-size:.85rem;cursor:pointer;transition:all .3s;display:flex;align-items:center;justify-content:center}
.ctrl-btn:hover{border-color:#00d4ff;box-shadow:0 0 14px rgba(0,212,255,0.2)}
.ctrl-btn.play{width:46px;height:46px;font-size:1.1rem;background:linear-gradient(135deg,#00d4ff,#7b2fff);color:#fff;border:none}
.ctrl-btn.play:hover{box-shadow:0 0 24px rgba(0,212,255,0.4)}
.ctrl-btn.sm{width:28px;height:28px;font-size:.65rem}
#volumeWrap{display:flex;align-items:center;gap:4px}
#volumeSlider{width:55px;accent-color:#00d4ff}

body.immersive #topbar,body.immersive #leftPanel,body.immersive #controls,body.immersive #trackSection,body.immersive #starTrailWrap,body.immersive #trailTimes,body.immersive #albumCard,body.immersive .panel-header,body.immersive #searchBox,body.immersive #playlist{opacity:0;transition:opacity .6s;pointer-events:none}
body.immersive #rightPanel{background:transparent!important;border-color:transparent!important;backdrop-filter:none!important}
body.immersive .panel{background:transparent!important;backdrop-filter:none!important;border-color:transparent!important}
body.immersive #planetZone canvas{opacity:1}
body.immersive #themePicker{opacity:.25}
body.immersive #immerseBtn{opacity:.35}
body.immersive #userBtn{opacity:0;pointer-events:none}
body.immersive #trackTitle,body.immersive #trackArtist{opacity:0}
#immerseBtn{position:fixed;bottom:20px;right:20px;z-index:60;width:44px;height:44px;border-radius:50%;border:2px solid rgba(0,212,255,0.4);background:rgba(0,20,50,0.7);color:#00d4ff;cursor:pointer;font-size:1.1rem;transition:all .3s;backdrop-filter:blur(8px);box-shadow:0 0 18px rgba(0,212,255,0.15)}
#immerseBtn:hover{border-color:#00d4ff;box-shadow:0 0 28px rgba(0,212,255,0.4);transform:scale(1.08);background:rgba(0,30,70,0.85)}
#topbar,#leftPanel,#controls,#trackSection,#starTrailWrap,#trailTimes,#albumCard,.panel-header{transition:opacity .4s}

#themePicker{position:fixed;bottom:14px;left:14px;z-index:50;display:flex;gap:6px}
.theme-dot{width:24px;height:24px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:all .3s}
.theme-dot.active{border-color:#fff;box-shadow:0 0 12px currentColor}
.theme-dot:hover{transform:scale(1.15)}

#loginOverlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:100;align-items:center;justify-content:center}
#loginOverlay.show{display:flex}
#loginBox{background:rgba(3,8,22,0.95);backdrop-filter:blur(20px);border:1px solid rgba(0,212,255,0.25);border-radius:18px;padding:32px;text-align:center;max-width:340px;width:90%}
#loginBox h2{font-family:'Orbitron';font-size:1.2rem;margin-bottom:18px;color:#00d4ff}
#qqLoginBtn{padding:11px 30px;border:none;border-radius:24px;font-size:.95rem;cursor:pointer;background:linear-gradient(135deg,#12b7f5,#0d8bcc);color:#fff;font-weight:700;transition:all .3s;width:100%}
#qqLoginBtn:hover{box-shadow:0 0 20px rgba(18,183,245,0.4)}
#skipLogin{display:block;margin-top:12px;color:#445;cursor:pointer;font-size:.75rem;background:none;border:none;width:100%}
.toast{position:fixed;bottom:70px;left:50%;transform:translateX(-50%);padding:9px 20px;border-radius:18px;background:rgba(0,212,255,0.08);border:1px solid rgba(0,212,255,0.18);color:#00d4ff;font-size:.75rem;z-index:200;opacity:0;transition:opacity .3s;pointer-events:none}
.toast.show{opacity:1}
#resizeHandle{position:absolute;right:-2px;top:0;bottom:0;width:5px;cursor:col-resize;z-index:10}
#resizeHandle:hover{background:rgba(0,212,255,0.25)}

/* Lyrics — cosmic scroll */
#lyricsOverlay{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:6;height:60%;overflow:hidden;pointer-events:none;text-align:center;width:80%;max-width:500px}
#lyricsStage{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;mask-image:linear-gradient(to bottom,transparent 5%,#fff 30%,#fff 70%,transparent 95%);-webkit-mask-image:linear-gradient(to bottom,transparent 5%,#fff 30%,#fff 70%,transparent 95%)}
.lyric-line{transition:all .5s cubic-bezier(.23,1,.32,1);font-size:.75rem;color:rgba(255,255,255,0.18);line-height:2.6;white-space:nowrap;position:relative;letter-spacing:1px}
.lyric-line.active{color:#fff;font-size:1.05rem;font-weight:700;text-shadow:0 0 20px rgba(0,212,255,0.9),0 0 40px rgba(120,40,255,0.5),0 0 80px rgba(0,212,255,0.3);letter-spacing:2px}
.lyric-line.active::before,.lyric-line.active::after{content:'◆';position:absolute;top:50%;transform:translateY(-50%);font-size:.5rem;color:rgba(0,212,255,0.6);animation:dotPulse 1.5s ease-in-out infinite}
.lyric-line.active::before{left:-24px;animation-delay:0s}
.lyric-line.active::after{right:-24px;animation-delay:.75s}
@keyframes dotPulse{0%,100%{opacity:.3;transform:translateY(-50%) scale(.7)}50%{opacity:1;transform:translateY(-50%) scale(1.3)}}
body.immersive #lyricsOverlay{width:60%;max-width:700px}
body.immersive .lyric-line.active{font-size:1.3rem;text-shadow:0 0 30px rgba(0,212,255,1),0 0 60px rgba(120,40,255,0.7),0 0 100px rgba(0,212,255,0.4)}
.lyrics-toggle{position:absolute;right:14px;bottom:14px;z-index:7;padding:5px 12px;border-radius:14px;border:1px solid rgba(0,212,255,0.2);background:rgba(3,8,22,0.6);color:#00d4ff;cursor:pointer;font-size:.7rem;transition:all .2s}
.lyrics-toggle:hover{border-color:#00d4ff;box-shadow:0 0 12px rgba(0,212,255,0.2)}
.lyrics-toggle.hidden-state{opacity:.4}
@media(max-width:768px){#main{flex-direction:column;padding:0 6px}#leftPanel{width:100%;max-height:220px}#planetZone{min-height:150px}#albumCard{width:70px;right:6px}}
</style>
</head>
<body>
<canvas id="bg"></canvas>
<div id="app">
  <div id="topbar">
    <div class="logo">COSMIC<span style="font-size:.45rem;display:block;letter-spacing:3px;opacity:.6">UNIVERSE PLAYER</span></div>
    <button id="userBtn" onclick="toggleLogin()">🚀 登录</button>
  </div>
  <div id="main">
    <div class="panel" id="leftPanel">
      <div class="panel-header">🎵 播放列表 <span id="plCount" style="font-size:.6rem;color:#556">0</span>
  <span style="display:flex;gap:4px">
    <span onclick="loadRecommend()" style="cursor:pointer;font-size:.6rem;padding:2px 6px;border-radius:8px;border:1px solid rgba(0,212,255,0.2);color:#00d4ff" title="每日推荐">📅</span>
    <span onclick="loadPlaylists()" style="cursor:pointer;font-size:.6rem;padding:2px 6px;border-radius:8px;border:1px solid rgba(0,212,255,0.2);color:#00d4ff" title="我的歌单">📋</span>
    <span onclick="loadLikedSongs()" style="cursor:pointer;font-size:.6rem;padding:2px 6px;border-radius:8px;border:1px solid rgba(0,212,255,0.2);color:#00d4ff" title="我喜欢的">❤️</span>
  </span>
  <span class="collapse-btn" onclick="toggleLeftPanel()" id="collapseIcon">◀</span>
</div>
      <div id="searchBox">
        <input type="text" id="searchInput" placeholder="搜索歌曲..." onkeydown="if(event.key==='Enter')doSearch()">
        <button onclick="doSearch()">▶</button>
        <div id="searchResults"></div>
      </div>
      <div id="playlist"><div style="color:#556;text-align:center;padding:30px 0;font-size:.75rem">搜索歌曲添加</div></div>
    </div>
    <div class="panel" id="rightPanel">
      <div class="panel-header">🌍 深空星域</div>
      <div id="planetZone">
        <canvas id="planetCanvas"></canvas>
        <div id="albumCard"><span class="ph">🌌</span></div>
        <div id="lyricsOverlay"><div id="lyricsStage"></div></div>
        <button class="lyrics-toggle" id="lyricsToggle" onclick="window.toggleLyrics()">🎤 歌词</button>
      </div>
      <div id="trackSection">
        <div id="trackTitle" style="color:#556">等待播放</div>
        <div id="trackArtist">—</div>
      </div>
      <div id="starTrailWrap"><canvas id="starTrailCanvas"></canvas></div>
      <div id="trailTimes"><span id="trailCur">0:00</span><span id="trailDur">0:00</span></div>
      <div id="controls">
        <button class="ctrl-btn sm" onclick="toggleMode()" id="modeBtn">🔀</button>
        <button class="ctrl-btn" onclick="prevSong()">⏮</button>
        <button class="ctrl-btn play" id="playBtn" onclick="togglePlay()">▶</button>
        <button class="ctrl-btn" onclick="nextSong()">⏭</button>
        <div id="volumeWrap"><span style="font-size:.65rem;color:#556">🔊</span><input type="range" id="volumeSlider" min="0" max="100" value="70" oninput="setVol()"></div>
      </div>
    </div>
  </div>
</div>
<button id="immerseBtn" onclick="toggleImmersive()" title="沉浸模式 (ESC)">🌌</button>
<div id="themePicker">
  <div class="theme-dot active" style="background:#0d1b3e" onclick="switchTheme(0)" title="深空蓝"></div>
  <div class="theme-dot" style="background:#1a0d28" onclick="switchTheme(1)" title="紫红星云"></div>
  <div class="theme-dot" style="background:#0d1a18" onclick="switchTheme(2)" title="极光绿"></div>
  <div class="theme-dot" style="background:#1a0f08" onclick="switchTheme(3)" title="赤红星系"></div>
</div>
<div id="loginOverlay"><div id="loginBox">
  <h2>🌌 登录宇宙播放器</h2>
  <div id="loginStep1">
    <button id="qqLoginBtn" onclick="qqLogin()" style="width:100%;padding:12px;border:none;border-radius:24px;font-size:.95rem;cursor:pointer;background:linear-gradient(135deg,#12b7f5,#0d8bcc);color:#fff;font-weight:700;margin-bottom:8px;transition:all .3s">🐧 QQ 账号登录</button>
    <button onclick="showNeteaseLogin()" style="width:100%;padding:12px;border:1px solid rgba(255,50,50,0.3);border-radius:24px;font-size:.9rem;cursor:pointer;background:transparent;color:#f55;transition:all .3s">🎵 网易云扫码登录</button>
    <button id="skipLogin" onclick="skipLogin()" style="margin-top:12px;display:block;width:100%;background:none;border:none;color:#556;cursor:pointer;font-size:.75rem">跳过，直接使用</button>
  </div>
  <div id="loginStepNE" style="display:none;text-align:center">
    <div id="neQRwrap" style="width:180px;height:180px;margin:0 auto 12px;background:#fff;border-radius:12px;display:flex;align-items:center;justify-content:center">
      <canvas id="neQRcanvas" style="width:160px;height:160px"></canvas>
    </div>
    <div id="neQRstatus" style="color:#889;font-size:.78rem;margin-bottom:10px">请用网易云音乐App扫码</div>
    <button onclick="refreshNELogin()" style="padding:8px 20px;border:1px solid rgba(255,50,50,0.25);border-radius:20px;background:transparent;color:#f55;cursor:pointer;font-size:.78rem;margin-bottom:8px">🔄 刷新</button>
    <button onclick="backToLoginStep1()" style="display:block;margin:0 auto;background:none;border:none;color:#556;cursor:pointer;font-size:.72rem">返回</button>
  </div>
</div></div>
<audio id="audioPlayer" preload="auto"></audio>
<div class="toast" id="toast"></div>

<meta http-equiv="Cache-Control" content="no-cache"><script type="importmap">
{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.157.0/build/three.module.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.157.0/examples/jsm/"}}
</script>

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
window._err=function(m){const t=document.getElementById('toast');if(t){t.textContent='ERR: '+m;t.className='toast show'}else{alert('ERR: '+m)}};
window.addEventListener('error',e=>{window._err(e.message)});
window.addEventListener('unhandledrejection',e=>{window._err(e.reason?.message||'Promise error')});

// ============ SPACE BG ============
const bgCanvas=document.getElementById('bg');
const bgR=new THREE.WebGLRenderer({canvas:bgCanvas,antialias:true,alpha:true});
bgR.setPixelRatio(Math.min(devicePixelRatio,2));
bgR.setSize(innerWidth,innerHeight);
const sS=new THREE.Scene();
const sC=new THREE.PerspectiveCamera(70,innerWidth/innerHeight,0.1,80);
sC.position.set(0,1.5,8);sC.lookAt(0,0,-3);

// Glow sprite textures
function glowTex(inner,outer){const c=document.createElement('canvas');c.width=128;c.height=128;const x=c.getContext('2d');const g=x.createRadialGradient(64,64,0,64,64,64);g.addColorStop(0,inner);g.addColorStop(0.08,inner);g.addColorStop(0.35,outer);g.addColorStop(1,'rgba(0,0,0,0)');x.fillStyle=g;x.fillRect(0,0,128,128);const t=new THREE.CanvasTexture(c);t.needsUpdate=true;return t}
const gTexBlue=glowTex('rgba(160,210,255,1)','rgba(30,60,200,0.4)');
const gTexWarm=glowTex('rgba(255,200,140,1)','rgba(200,80,20,0.4)');

function starLayer(n,sz,sp,cl,tex){
  const g=new THREE.BufferGeometry();const p=new Float32Array(n*3);const c=new Float32Array(n*3);
  for(let i=0;i<n;i++){const th=Math.random()*Math.PI*2,ph=Math.acos(2*Math.random()-1),r=sp[0]+Math.random()*(sp[1]-sp[0]);p[i*3]=r*Math.sin(ph)*Math.cos(th);p[i*3+1]=r*Math.sin(ph)*Math.sin(th);p[i*3+2]=r*Math.cos(ph);const co=new THREE.Color().setHSL(cl[0]+Math.random()*cl[1],0.55,0.5+Math.random()*cl[2]);c[i*3]=co.r;c[i*3+1]=co.g;c[i*3+2]=co.b}
  g.setAttribute('position',new THREE.BufferAttribute(p,3));g.setAttribute('color',new THREE.BufferAttribute(c,3));
  return new THREE.Points(g,new THREE.PointsMaterial({size:sz,map:tex||null,vertexColors:true,blending:THREE.AdditiveBlending,depthWrite:false,transparent:true,opacity:0.85}));
}
const sl1=starLayer(5000,0.13,[5,40],[0.56,0.25,0.5],gTexBlue);
const sl2=starLayer(3000,0.20,[8,30],[0.59,0.18,0.42],gTexBlue);
const sl3=starLayer(1000,0.30,[10,26],[0.61,0.12,0.35],gTexWarm);
const sl4=starLayer(250,0.50,[5,22],[0.57,0.22,0.32],gTexBlue);
sS.add(sl1,sl2,sl3,sl4);

// Nebula — higher quality
const ng=new THREE.Group();
for(let i=0;i<8;i++){
  const g=new THREE.SphereGeometry(2+Math.random()*4,32,32);
  const m=new THREE.MeshBasicMaterial({color:new THREE.Color().setHSL(0.55+Math.random()*0.3,0.45,0.08+Math.random()*0.18),transparent:true,opacity:0.14,depthWrite:false});
  const n=new THREE.Mesh(g,m);n.position.set((Math.random()-0.5)*22,(Math.random()-0.5)*14,(Math.random()-0.5)*12-5);ng.add(n);
}
sS.add(ng);

// Milky way — more particles
const mwG=new THREE.BufferGeometry();const mwP=new Float32Array(4000*3);const mwC=new Float32Array(4000*3);
for(let i=0;i<4000;i++){mwP[i*3]=(Math.random()-0.5)*35;mwP[i*3+1]=(Math.random()-0.5)*2.5;mwP[i*3+2]=(Math.random()-0.5)*7-2;const c=new THREE.Color().setHSL(0.58+Math.random()*0.12,0.3,0.1+Math.random()*0.22);mwC[i*3]=c.r;mwC[i*3+1]=c.g;mwC[i*3+2]=c.b}
mwG.setAttribute('position',new THREE.BufferAttribute(mwP,3));mwG.setAttribute('color',new THREE.BufferAttribute(mwC,3));
const mw=new THREE.Points(mwG,new THREE.PointsMaterial({size:0.10,map:gTexBlue,vertexColors:true,blending:THREE.AdditiveBlending,depthWrite:false,transparent:true,opacity:0.6}));
mw.rotation.x=0.6;mw.rotation.y=0.3;sS.add(mw);

// Earth — 1024x512 high-res texture
const earthG=new THREE.SphereGeometry(0.55,56,56);
const ec=document.createElement('canvas');ec.width=1024;ec.height=512;const ex=ec.getContext('2d');
// Ocean base with depth variation
const og=ex.createLinearGradient(0,0,0,512);
og.addColorStop(0,'#152d5e');og.addColorStop(0.15,'#1a4078');og.addColorStop(0.3,'#1e5090');og.addColorStop(0.5,'#2366a8');og.addColorStop(0.7,'#1e5090');og.addColorStop(0.85,'#1a4078');og.addColorStop(1,'#152d5e');
ex.fillStyle=og;ex.fillRect(0,0,1024,512);
// Ocean texture noise
for(let i=0;i<3000;i++){const x=Math.random()*1024,y=Math.random()*512;const v=Math.random()>0.5?40:0;ex.fillStyle=`rgba(${v},${v+20},${v+80},0.03)`;ex.fillRect(x,y,4+Math.random()*12,3+Math.random()*6)}
// Detailed continents
ex.fillStyle='#3d8b40';
const continents=[[200,100,140,90],[480,120,160,110],[750,80,120,80],[130,240,80,100],[380,230,130,90],[650,210,100,85],[820,190,80,95],[280,300,110,85],[500,310,140,80],[720,290,90,70],[160,360,75,80],[400,370,100,75],[600,360,85,60],[850,340,65,70],[320,140,55,65],[550,160,60,55],[700,130,50,60]];
continents.forEach(([cx,cy,rw,rh])=>{ex.beginPath();ex.ellipse(cx,cy,rw,rh,Math.random()*0.3,0,Math.PI*2);ex.fill()});
// Inland terrain variation
ex.fillStyle='#2d7030';
for(let i=0;i<200;i++){const cx=Math.random()*1024,cy=Math.random()*512;ex.beginPath();ex.arc(cx,cy,8+Math.random()*25,0,Math.PI*2);ex.fill()}
// Mountain ridges
ex.fillStyle='#5a7a4a';
for(let i=0;i<80;i++){const cx=Math.random()*1024,cy=Math.random()*400+20;ex.beginPath();ex.ellipse(cx,cy,15+Math.random()*40,3+Math.random()*8,Math.random()*Math.PI,0,Math.PI*2);ex.fill()}
// Coastal highlights
ex.strokeStyle='rgba(180,210,160,0.4)';ex.lineWidth=2;
continents.forEach(([cx,cy,rw,rh])=>{ex.beginPath();ex.ellipse(cx,cy,rw+3,rh+3,0,0,Math.PI*2);ex.stroke()})
// Ice caps
ex.fillStyle='rgba(235,240,248,0.6)';ex.fillRect(0,0,1024,30);ex.fillRect(0,460,1024,52);
const iceG=ex.createLinearGradient(0,30,0,0);iceG.addColorStop(0,'rgba(235,240,248,0)');iceG.addColorStop(1,'rgba(235,240,248,0.6)');ex.fillStyle=iceG;ex.fillRect(0,30,1024,15);
// Clouds
ex.fillStyle='rgba(255,255,255,0.2)';
for(let i=0;i<150;i++){const cx=Math.random()*1024,cy=Math.random()*512;ex.beginPath();ex.ellipse(cx,cy,20+Math.random()*60,3+Math.random()*10,Math.random()*Math.PI,0,Math.PI*2);ex.fill()}
const earthTex=new THREE.CanvasTexture(ec);earthTex.colorSpace=THREE.SRGBColorSpace;earthTex.anisotropy=4;
