// Detailed planet texture — 1024x512 high-res
const ptCanvas=document.createElement('canvas');ptCanvas.width=1024;ptCanvas.height=512;
const ptx=ptCanvas.getContext('2d');
// Multi-stop base gradient
const bgGrad=ptx.createLinearGradient(0,0,0,512);
bgGrad.addColorStop(0,'#e0cdb8');bgGrad.addColorStop(0.1,'#d8c4a8');bgGrad.addColorStop(0.3,'#c8b090');bgGrad.addColorStop(0.5,'#bfa880');bgGrad.addColorStop(0.7,'#8b7050');bgGrad.addColorStop(0.9,'#a08868');bgGrad.addColorStop(1,'#e0cdb8');
ptx.fillStyle=bgGrad;ptx.fillRect(0,0,1024,512);
// Fine surface noise
for(let i=0;i<8000;i++){const x=Math.random()*1024,y=Math.random()*512,s=2+Math.random()*6;const a=0.015+Math.random()*0.05;const v=Math.random()>0.5?255:0;ptx.fillStyle=`rgba(${v},${v},${v},${a})`;ptx.fillRect(x,y,s,s*0.6)}
// Larger surface patches
for(let i=0;i<200;i++){const cx=Math.random()*1024,cy=Math.random()*512;const g=ptx.createRadialGradient(cx,cy,0,cx,cy,20+Math.random()*40);const v=Math.random()>0.5?80:200;g.addColorStop(0,`rgba(${v},${v-10},${v-30},0.08)`);g.addColorStop(1,'rgba(0,0,0,0)');ptx.fillStyle=g;ptx.beginPath();ptx.arc(cx,cy,20+Math.random()*40,0,Math.PI*2);ptx.fill()}
// Craters — more detailed
for(let i=0;i<80;i++){const cx=Math.random()*1024,cy=Math.random()*512,r=3+Math.random()*20;const g=ptx.createRadialGradient(cx-r*0.25,cy-r*0.25,0,cx,cy,r);g.addColorStop(0,'rgba(200,180,160,0.6)');g.addColorStop(0.1,'rgba(180,160,140,0.4)');g.addColorStop(0.4,'rgba(90,70,50,0.35)');g.addColorStop(0.7,'rgba(140,120,100,0.2)');g.addColorStop(1,'rgba(0,0,0,0)');ptx.fillStyle=g;ptx.beginPath();ptx.arc(cx,cy,r,0,Math.PI*2);ptx.fill()}
// Ridge/mountain lines
ptx.strokeStyle='rgba(160,140,120,0.12)';ptx.lineWidth=1;
for(let i=0;i<25;i++){ptx.beginPath();let x=Math.random()*1024,y=Math.random()*512;ptx.moveTo(x,y);for(let j=0;j<10;j++){x+=(Math.random()-0.5)*50;y+=(Math.random()-0.5)*25;ptx.lineTo(x,y)}ptx.stroke()}
// Cracked surface fissures
ptx.strokeStyle='rgba(60,40,20,0.08)';ptx.lineWidth=0.5;
for(let i=0;i<30;i++){ptx.beginPath();let x=Math.random()*1024,y=Math.random()*512;ptx.moveTo(x,y);for(let j=0;j<6;j++){x+=(Math.random()-0.5)*30;y+=(Math.random()-0.5)*15;ptx.lineTo(x,y)}ptx.stroke()}
// Polar ice caps
const poleGrad=ptx.createLinearGradient(0,0,0,35);poleGrad.addColorStop(0,'rgba(240,235,225,0.6)');poleGrad.addColorStop(1,'rgba(240,235,225,0)');ptx.fillStyle=poleGrad;ptx.fillRect(0,0,1024,35);
const poleGrad2=ptx.createLinearGradient(0,512,0,477);poleGrad2.addColorStop(0,'rgba(240,235,225,0.6)');poleGrad2.addColorStop(1,'rgba(240,235,225,0)');ptx.fillStyle=poleGrad2;ptx.fillRect(0,477,1024,35);
const planetTex=new THREE.CanvasTexture(ptCanvas);planetTex.colorSpace=THREE.SRGBColorSpace;planetTex.anisotropy=8;

