// Atmosphere particles — 600 floating dots around planet
const atmoParticlesG=new THREE.BufferGeometry();
const apCount=600;const apPos=new Float32Array(apCount*3);const apClr=new Float32Array(apCount*3);
for(let i=0;i<apCount;i++){
  const phi=Math.acos(2*Math.random()-1),theta=Math.random()*Math.PI*2;
  const r=0.88+Math.random()*0.25;
  apPos[i*3]=r*Math.sin(phi)*Math.cos(theta);apPos[i*3+1]=r*Math.sin(phi)*Math.sin(theta);apPos[i*3+2]=r*Math.cos(phi);
  const c=new THREE.Color().setHSL(0.56+Math.random()*0.1,0.4,0.5+Math.random()*0.5);
  apClr[i*3]=c.r;apClr[i*3+1]=c.g;apClr[i*3+2]=c.b;
}
atmoParticlesG.setAttribute('position',new THREE.BufferAttribute(apPos,3));
atmoParticlesG.setAttribute('color',new THREE.BufferAttribute(apClr,3));
const atmoParticles=new THREE.Points(atmoParticlesG,new THREE.PointsMaterial({size:0.015,vertexColors:true,blending:THREE.AdditiveBlending,depthWrite:false,transparent:true,opacity:0.7}));
cS.add(atmoParticles);

// Orbital progress ring — key interactive element
const ringRadius=1.35;
const ringSegments=240;
const ringParticlesG=new THREE.BufferGeometry();
const ringPos=new Float32Array(ringSegments*3);
const ringClr=new Float32Array(ringSegments*3);
for(let i=0;i<ringSegments;i++){
  const angle=(i/ringSegments)*Math.PI*2-Math.PI/2;
  ringPos[i*3]=Math.cos(angle)*ringRadius;
  ringPos[i*3+1]=Math.sin(angle)*ringRadius;
  ringPos[i*3+2]=0;
  ringClr[i*3]=0.1;ringClr[i*3+1]=0.2;ringClr[i*3+2]=0.3;
}
ringParticlesG.setAttribute('position',new THREE.BufferAttribute(ringPos,3));
ringParticlesG.setAttribute('color',new THREE.BufferAttribute(ringClr,3));
const ringMat=new THREE.PointsMaterial({size:0.045,vertexColors:true,blending:THREE.AdditiveBlending,depthWrite:false});
const ringMesh=new THREE.Points(ringParticlesG,ringMat);
ringMesh.rotation.x=Math.PI/2.35;
cS.add(ringMesh);

// Thin second ring (decorative, outer)
const ring2G=new THREE.TorusGeometry(1.55,0.012,8,160);
const ring2=new THREE.Mesh(ring2G,new THREE.MeshBasicMaterial({color:0x3366aa,transparent:true,opacity:0.3}));
ring2.rotation.x=Math.PI/2.5;cS.add(ring2);

