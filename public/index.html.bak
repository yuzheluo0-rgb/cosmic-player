orbitControls.enabled=false; // 默认关闭，沉浸模式开启

// Raycaster for ring interaction
const raycaster=new THREE.Raycaster();
raycaster.params.Points.threshold=0.15;
const mouse=new THREE.Vector2();
let isDraggingRing=false;

function updateRingProgress(prog){
  const clr=ringParticlesG.attributes.color.array;
  const active=Math.floor(prog*ringSegments);
  for(let i=0;i<ringSegments;i++){
    if(i<active){
      const hue=0.55+(i/ringSegments)*0.12;
      const c=new THREE.Color().setHSL(hue,0.9,0.45+Math.sin(i*0.15+performance.now()*0.002)*0.2);
      clr[i*3]=c.r;clr[i*3+1]=c.g;clr[i*3+2]=c.b;
    }else if(i===active){
      clr[i*3]=1;clr[i*3+1]=1;clr[i*3+2]=1; // Bright white leading edge
    }else{
      clr[i*3]=0.06;clr[i*3+1]=0.1;clr[i*3+2]=0.16;
    }
  }
  ringParticlesG.attributes.color.needsUpdate=true;
  // Update time labels
  updateTimeLabels(prog);
}

function updateTimeLabels(prog){
  const zone=document.getElementById('planetZone');
  const zw=zone.clientWidth,zh=zone.clientHeight;
  const cx=zw/2,cy=zh/2;
  const rx=Math.min(zw,zh)*0.32;
  const sAngle=-Math.PI/2,startX=cx+Math.cos(sAngle)*rx,startY=cy+Math.sin(sAngle)*rx;
  timeStartEl.style.left=(startX-12)+'px';timeStartEl.style.top=(startY-8)+'px';
  timeStartEl.textContent=document.getElementById('trailCur').textContent;
  const eAngle=Math.PI*1.5,endX=cx+Math.cos(eAngle)*rx,endY=cy+Math.sin(eAngle)*rx;
  timeEndEl.style.left=(endX-12)+'px';timeEndEl.style.top=(endY-8)+'px';
  timeEndEl.textContent=document.getElementById('trailDur').textContent;
}

// Ring drag interaction
function getRingProgressFromMouse(e){
  const zone=document.getElementById('planetZone');
  const rect=zone.getBoundingClientRect();
  const cx=rect.width/2,cy=rect.height/2;
  const x=e.clientX-rect.left-cx,y=e.clientY-rect.top-cy;
  let angle=Math.atan2(y,x)+Math.PI/2; // start from top
  if(angle<0)angle+=Math.PI*2;
  return angle/(Math.PI*2);
}

pc.addEventListener('mousedown',e=>{
  if(!window.audioEl||!window.audioEl.duration)return;
  mouse.x=((e.clientX-pc.getBoundingClientRect().left)/pc.clientWidth)*2-1;
  mouse.y=-((e.clientY-pc.getBoundingClientRect().top)/pc.clientHeight)*2+1;
  raycaster.setFromCamera(mouse,cC);
  const intersects=raycaster.intersectObject(ringMesh);
  if(intersects.length>0){isDraggingRing=true;pc.style.cursor='grabbing';e.preventDefault()}
});
document.addEventListener('mousemove',e=>{
  if(!isDraggingRing){
    // Hover detection
    if(!window.audioEl||!window.audioEl.duration)return;
    mouse.x=((e.clientX-pc.getBoundingClientRect().left)/pc.clientWidth)*2-1;
    mouse.y=-((e.clientY-pc.getBoundingClientRect().top)/pc.clientHeight)*2+1;
    raycaster.setFromCamera(mouse,cC);
    const intersects=raycaster.intersectObject(ringMesh);
    if(intersects.length>0){
      pc.style.cursor='pointer';
      const prog=getRingProgressFromMouse(e);
      timeHoverEl.style.display='block';
      timeHoverEl.textContent=fTime(prog*window.audioEl.duration*1000);
      timeHoverEl.style.left=(e.clientX-pc.getBoundingClientRect().left+15)+'px';
      timeHoverEl.style.top=(e.clientY-pc.getBoundingClientRect().top-20)+'px';
    }else{
      pc.style.cursor='default';
      timeHoverEl.style.display='none';
    }
    return;
  }
  if(!window.audioEl||!window.audioEl.duration)return;
  const prog=getRingProgressFromMouse(e);
  window.audioEl.currentTime=prog*window.audioEl.duration;
  updateRingProgress(prog);
});
document.addEventListener('mouseup',()=>{isDraggingRing=false;pc.style.cursor='default';timeHoverEl.style.display='none'});

// Floating debris orbiting
const debrisG=new THREE.BufferGeometry();
const debrisCount=80;const debrisPos=new Float32Array(debrisCount*3);
for(let i=0;i<debrisCount;i++){
  const a=Math.random()*Math.PI*2,r=1.0+Math.random()*0.6;
  debrisPos[i*3]=Math.cos(a)*r;debrisPos[i*3+1]=Math.sin(a)*r;debrisPos[i*3+2]=(Math.random()-0.5)*0.3;
}
debrisG.setAttribute('position',new THREE.BufferAttribute(debrisPos,3));
const debrisMesh=new THREE.Points(debrisG,new THREE.PointsMaterial({size:0.018,color:0x8899bb,blending:THREE.AdditiveBlending,depthWrite:false}));
debrisMesh.rotation.x=Math.PI/2.35;cS.add(debrisMesh);
moonM2.position.set(1.7,0.15,0);cS.add(moonM2);

// ============ STAR TRAIL CANVAS (kept minimal for time text) ============
const tc=document.getElementById('starTrailCanvas');const tctx=tc.getContext('2d');
function drawTrail(prog){
  const wrap=document.getElementById('starTrailWrap');
  const w=wrap.clientWidth,h=22;
  if(tc.width!==w||tc.height!==h){tc.width=w;tc.height=h}
  tctx.clearRect(0,0,w,h);
  const cy=h/2;
  // Draw subtle glow line just for reference
  tctx.beginPath();tctx.moveTo(20,cy);tctx.lineTo(w-20,cy);
  tctx.strokeStyle='rgba(255,255,255,0.03)';tctx.lineWidth=1;tctx.stroke();
  // Central dot showing position
  const lx=20+prog*(w-40);
  tctx.fillStyle='rgba(0,212,255,0.3)';tctx.beginPath();tctx.arc(lx,cy,3,0,Math.PI*2);tctx.fill();
}

// ============ THEME ============
const themes=[
  {n:'深空蓝',h:0.58,pc:0x335577,ac:0x556688},
  {n:'紫红星云',h:0.78,pc:0x442244,ac:0x664455},
  {n:'极光绿',h:0.38,pc:0x224433,ac:0x446655},
  {n:'赤红星系',h:0.08,pc:0x442211,ac:0x664422},
];
let ct=0;
function applyTheme(i){
  ct=i;
  const t=themes[i];
[sl1,sl2,sl3,sl4].forEach((l,li)=>{const cl=l.geometry.attributes.color.array;const b=0.5+li*0.25;for(let j=0;j<cl.length/3;j++){const c=new THREE.Color().setHSL(t.h+(Math.random()-0.5)*0.1,b*0.6,b*0.45+Math.random()*0.55);cl[j*3]=c.r;cl[j*3+1]=c.g;cl[j*3+2]=c.b}l.geometry.attributes.color.needsUpdate=true});
  ng.children.forEach(n=>{n.material.color.setHSL(t.h+(Math.random()-0.5)*0.08,0.35,0.13)});
  cpM.color.set(t.pc);document.querySelectorAll('.theme-dot').forEach((d,j)=>d.classList.toggle('active',j===i));
}
window.switchTheme=function(i){applyTheme(i);toast('背景: '+themes[i].n);updateRingProgress(window.audioEl&&window.audioEl.duration?window.audioEl.currentTime/window.audioEl.duration:0)};
applyTheme(0);

function resizeAll(){
  bgR.setSize(innerWidth,innerHeight);sC.aspect=innerWidth/innerHeight;sC.updateProjectionMatrix();
  const pd=document.getElementById('planetZone');const pw=pd.clientWidth,ph=pd.clientHeight;
  if(pw>0&&ph>0){pR.setSize(pw,ph);cC.aspect=pw/ph;cC.updateProjectionMatrix()}
}
window.addEventListener('resize',resizeAll);

let t=0,cmt=0,mt=0;
function animate(){
  requestAnimationFrame(animate);t+=0.01;cmt++;mt++;
  sl1.rotation.y+=0.00004;sl2.rotation.y+=0.00008;sl3.rotation.y+=0.00015;sl4.rotation.y+=0.00006;
  sl1.rotation.x+=0.00002;sl2.rotation.x+=0.00003;sl4.rotation.x+=0.00001;
  earth.userData.oa+=earth.userData.os*0.005;const a=earth.userData.oa;earth.position.x=Math.cos(a)*earth.userData.or;earth.position.z=Math.sin(a)*earth.userData.or-3;earth.rotation.y+=0.002;
  dpData.forEach(d=>{d.oa+=d.os*0.005;d.m.position.x=Math.cos(d.oa)*d.or;d.m.position.z=Math.sin(d.oa)*d.or-2});
  if(cmt>100+Math.random()*250){cmt=0;newComet()}comets.forEach(c=>{c.userData.life++;c.position.x+=c.userData.sp;c.userData.head.material.opacity=0.9-(c.userData.life/c.userData.ml)*0.8;if(c.userData.life>c.userData.ml){sS.remove(c);c.traverse(ch=>{if(ch.geometry)ch.geometry.dispose();if(ch.material)ch.material.dispose()});comets.splice(comets.indexOf(c),1)}});
  if(mt>20+Math.random()*50){mt=0;newMeteor()}meteors.forEach(m=>{m.userData.life++;m.position.x+=m.userData.sp;m.position.y-=m.userData.sp*0.5;if(m.userData.life>m.userData.ml){sS.remove(m);m.geometry.dispose();m.material.dispose();meteors.splice(meteors.indexOf(m),1)}});
  // Center planet
  cp.rotation.y+=0.0025;
  atmoParticles.rotation.y+=0.0008;atmoParticles.rotation.x+=0.0003;
  ring2.rotation.z+=0.0008;
  debrisMesh.rotation.z+=0.0015;
  moonM2.rotation.y+=0.006;moonM2.position.x=Math.cos(t*0.25)*1.6;moonM2.position.z=Math.sin(t*0.25)*0.5;
  mw.rotation.y+=0.00003;
  orbitControls.update();bgR.render(sS,sC);resizeAll();pR.render(cS,cC);
  if(window.audioEl&&window.audioEl.duration)updateRingProgress(window.audioEl.currentTime/window.audioEl.duration);
  else updateRingProgress(0);
}
animate();

// ============ PLAYER ============
let playlist=[],cIdx=-1,isPlaying=false,mode='loop';
window.audioEl=document.getElementById('audioPlayer');
const audio=window.audioEl;
audio.volume=0.7;
audio.onended=()=>nextSong();
let lyricsData=[],lyricsVisible=true;
audio.ontimeupdate=()=>{
  if(!audio.duration)return;
  updateRingProgress(audio.currentTime/audio.duration);
  document.getElementById('trailCur').textContent=fTime(audio.currentTime*1000);
  document.getElementById('trailDur').textContent=fTime(audio.duration*1000);
  updateTimeLabels(audio.currentTime/audio.duration);
  syncLyrics(audio.currentTime);
};
audio.onerror=()=>{const m={1:'加载中断',2:'网络错误',3:'解码失败',4:'格式不支持'};toast('播放失败: '+(m[audio.error?.code]||'未知'))};
audio.onplay=()=>{isPlaying=true;updatePb()};
audio.onpause=()=>{isPlaying=false;updatePb()};

async function api(ep,pr={}){
  const q=Object.entries(pr).map(([k,v])=>k+'='+encodeURIComponent(v)).join('&');
  return (await fetch('/api/music/'+ep+(q?'?'+q:''))).json();
}
window.doSearch=async function(){
  const kw=document.getElementById('searchInput').value.trim();if(!kw)return;
  const d=await api('cloudsearch',{keywords:kw,limit:20});
  const songs=d.result?.songs||[];
  const box=document.getElementById('searchResults');
  if(!songs.length){box.innerHTML='<div style="padding:16px;color:#556;font-size:.8rem">未找到</div>';box.style.display='block';return}
  box.innerHTML=songs.map((s,i)=>`<div class="song-item" onclick="addSong(${s.id},'${(s.name||'?').replace(/'/g,"\\'")}','${(s.ar?.[0]?.name||'?').replace(/'/g,"\\'")}',${s.dt||0})"><span class="idx">${i+1}</span><div class="info"><div class="name">${s.name}</div><div class="artist">${s.ar?.map(a=>a.name).join('/')||'?'}</div></div></div>`).join('');
  box.style.display='block';
  setTimeout(()=>document.addEventListener('click',function h(e){if(!box.contains(e.target)&&e.target!==document.getElementById('searchInput')){box.style.display='none';document.removeEventListener('click',h)}}),100);
};
window.addSong=function(id,name,artist,dt){
  playlist.push({id,name,artist,dt});renderPl();
  if(cIdx===-1){cIdx=0;playSong(0)}
  document.getElementById('searchResults').style.display='none';
  document.getElementById('searchInput').value='';toast('已添加: '+name);
};
window.removeSong=function(i,e){e.stopPropagation();if(i===cIdx){audio.pause();audio.src='';cIdx=-1;document.getElementById('trackTitle').textContent='等待播放';document.getElementById('trackTitle').style.color='#556';document.getElementById('trackArtist').textContent='—';document.getElementById('albumCard').innerHTML='<span class="ph">🌌</span>';updateRingProgress(0);document.getElementById('trailCur').textContent='0:00';document.getElementById('trailDur').textContent='0:00'}else if(i<cIdx)cIdx--;playlist.splice(i,1);renderPl();toast('已移除')};
function renderPl(){
  const el=document.getElementById('playlist');document.getElementById('plCount').textContent=playlist.length;
  if(!playlist.length){el.innerHTML='<div style="color:#556;text-align:center;padding:30px 0;font-size:.75rem">搜索歌曲添加</div>';return}
  el.innerHTML=playlist.map((s,i)=>`<div class="song-item${i===cIdx?' active':''}" onclick="playSong(${i})"><span class="idx">${i+1}</span><div class="info"><div class="name">${s.name}</div><div class="artist">${s.artist}</div></div><button class="del-btn" onclick="removeSong(${i},event)">✕</button></div>`).join('');
}
window.playSong=async function(i){
  if(i<0||i>=playlist.length)return;
  cIdx=i;renderPl();const s=playlist[i];
  document.getElementById('trackTitle').textContent=s.name;document.getElementById('trackTitle').style.color='';
  document.getElementById('trackArtist').textContent=s.artist;
  document.getElementById('albumCard').innerHTML='<span class="ph">⏳</span>';
  updateRingProgress(0);document.getElementById('trailCur').textContent='0:00';document.getElementById('trailDur').textContent='...';
  audio.pause();audio.src='/api/stream/'+s.id;audio.load();
  try{await audio.play()}catch(e){toast('点一下页面再试')}
  api('song_detail',{ids:s.id}).then(d=>{const c=d.songs?.[0]?.al?.picUrl;if(c)document.getElementById('albumCard').innerHTML=`<img src="${c}">`;else document.getElementById('albumCard').innerHTML='<span class="ph">🌌</span>'}).catch(()=>{});
  fetchLyrics(s.id);
};
window.togglePlay=function(){if(!playlist.length){toast('先搜索歌曲');return}if(!audio.src){playSong(0);return}if(isPlaying)audio.pause();else audio.play().catch(()=>{})};
function updatePb(){document.getElementById('playBtn').textContent=isPlaying?'⏸':'▶'}
window.nextSong=function(){if(!playlist.length)return;if(mode==='shuffle')cIdx=Math.floor(Math.random()*playlist.length);else cIdx=(cIdx+1)%playlist.length;playSong(cIdx)};
window.prevSong=function(){if(!playlist.length)return;cIdx=(cIdx-1+playlist.length)%playlist.length;playSong(cIdx)};
window.toggleMode=function(){const ms=['loop','shuffle','repeat'];const i=ms.indexOf(mode);mode=ms[(i+1)%3];document.getElementById('modeBtn').textContent={loop:'🔀',shuffle:'🔁',repeat:'🔂'}[mode];toast('模式: '+mode)};
window.setVol=function(){audio.volume=document.getElementById('volumeSlider').value/100};
function fTime(ms){if(!ms)return'0:00';const s=Math.floor(ms/1000);return Math.floor(s/60)+':'+(s%60).toString().padStart(2,'0')}

// ===== LOGIN =====
let neQRtimer=null;
let neUserInfo=null;
async function checkLogin(){
  // QQ user
  try{const r=await fetch('/api/user');const u=await r.json();if(u){renderUserBtn(u)}}catch(e){}
  // NetEase user
  try{const r=await fetch('/api/netease/user');const u=await r.json();if(u&&u.nickname){neUserInfo=u;renderUserBtn(u)}else{neUserInfo=null}}
}
function renderUserBtn(u){
  const btn=document.getElementById('userBtn');
  const avatar=u.avatar||'';
  btn.innerHTML=`${avatar?`<img src="${avatar}" onerror="this.style.display='none'" style="width:20px;height:20px;border-radius:50%;vertical-align:middle;margin-right:5px">`:''}<span>${u.nickname||'用户'}</span>`;
  btn.className='logged';
  btn.onclick=showUserMenu;
  btn.title='点击查看选项';
}
window.showUserMenu=function(){
  const opts=[];
  if(neUserInfo)opts.push({text:'🎵 退出网易云',action:logoutNE});
  if(opts.length===0){toggleLogin();return}
  const html=opts.map(o=>`<div class="song-item" onclick="(${o.action.toString()})()" style="font-size:.75rem">${o.text}</div>`).join('');
  const box=document.getElementById('searchResults');box.innerHTML=html;box.style.display='block';
  setTimeout(()=>document.addEventListener('click',function h(e){if(!box.contains(e.target)&&e.target!==document.getElementById('userBtn')){box.style.display='none';document.removeEventListener('click',h)}}),100);
};
async function logoutNE(){
  await fetch('/api/netease/logout',{method:'POST'});
  neUserInfo=null;document.getElementById('userBtn').innerHTML='🚀 登录';document.getElementById('userBtn').className='';document.getElementById('userBtn').onclick=toggleLogin;
  document.getElementById('searchResults').style.display='none';
  playlist=[];cIdx=-1;renderPl();audio.pause();audio.src='';
  document.getElementById('trackTitle').textContent='等待播放';document.getElementById('trackTitle').style.color='#556';
  document.getElementById('trackArtist').textContent='—';document.getElementById('albumCard').innerHTML='<span class="ph">🌌</span>';
  updateRingProgress(0);toast('已退出网易云');
}
window.toggleLogin=function(){document.getElementById('loginOverlay').classList.toggle('show');resetLoginUI()};
function resetLoginUI(){document.getElementById('loginStep1').style.display='';document.getElementById('loginStepNE').style.display='none';if(neQRtimer)clearInterval(neQRtimer)}
window.qqLogin=async function(){try{const r=await fetch('/api/login/qq');const d=await r.json();location.href=d.url}catch(e){toast('QQ登录暂不可用')}};
window.skipLogin=function(){document.getElementById('loginOverlay').classList.remove('show');toast('已跳过')};
window.showNeteaseLogin=function(){
  document.getElementById('loginStep1').style.display='none';
  document.getElementById('loginStepNE').style.display='';
  startNELogin();
};
window.backToLoginStep1=function(){resetLoginUI()};

async function startNELogin(){
  if(neQRtimer)clearInterval(neQRtimer);
  try{
    const r=await fetch('/api/login/netease/qr/key');const d=await r.json();
    const key=d.data?.unikey;if(!key){toast('获取二维码失败');return}
    const url=`https://music.163.com/login?codekey=${key}`;
    const c=document.getElementById('neQRcanvas');c.width=160;c.height=160;
    const ctx=c.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,160,160);
    // Use quickchart.io to generate QR
    const qrImg=new Image();
    qrImg.onload=()=>{ctx.drawImage(qrImg,0,0,160,160)};
    qrImg.src=`https://quickchart.io/qr?text=${encodeURIComponent(url)}&size=200&margin=2`;
    document.getElementById('neQRstatus').textContent='请用网易云音乐App扫码';
    let cnt=0;
    neQRtimer=setInterval(async()=>{
      cnt++;
      const cr=await fetch('/api/login/netease/qr/check?key='+key);const cd=await cr.json();
      if(cd.code===800){document.getElementById('neQRstatus').textContent='已过期，请刷新'}
      else if(cd.code===801){document.getElementById('neQRstatus').textContent='请在手机上确认'}
      else if(cd.code===802){document.getElementById('neQRstatus').textContent='授权中...'}
      else if(cd.code===803){
        clearInterval(neQRtimer);neQRtimer=null;
        document.getElementById('neQRstatus').textContent='登录成功！';
        setTimeout(()=>{document.getElementById('loginOverlay').classList.remove('show');checkLogin()},600);
      }
      if(cnt>90){clearInterval(neQRtimer);document.getElementById('neQRstatus').textContent='超时，请刷新'}
    },2000);
  }catch(e){toast('二维码加载失败')}
}
window.refreshNELogin=function(){startNELogin()};

// ===== 个人音乐功能 =====
window.loadRecommend=async function(){
  try{const r=await fetch('/api/netease/recommend');const d=await r.json();
    if(d.error){toast(d.error);return}
    const songs=d.data?.dailySongs||[];
    if(!songs.length){toast('请先登录网易云');return}
    playlist=[];cIdx=-1;
    songs.forEach(s=>{playlist.push({id:s.id,name:s.name,artist:s.ar?.map(a=>a.name).join('/')||'?',dt:s.dt||0})});
    if(playlist.length>0){cIdx=0;playSong(0)}renderPl();toast('每日推荐: '+playlist.length+' 首');
  }catch(e){toast('获取失败')}
};
window.loadPlaylists=async function(){
  try{const r=await fetch('/api/netease/playlists');const d=await r.json();
    if(d.error){toast(d.error);return}
    const pls=d.playlist||[];
    if(!pls.length){toast('请先登录网易云');return}
    // Show playlist picker in search results area
    const box=document.getElementById('searchResults');
    box.innerHTML=pls.map(p=>`<div class="song-item" onclick="loadPlaylistSongs(${p.id},'${(p.name||'歌单').replace(/'/g,"\\'")}')"><span class="idx">📋</span><div class="info"><div class="name">${p.name}</div><div class="artist">${p.trackCount||0} 首 · ${p.creator?.nickname||''}</div></div></div>`).join('');
    box.style.display='block';
    setTimeout(()=>document.addEventListener('click',function h(e){if(!box.contains(e.target)){box.style.display='none';document.removeEventListener('click',h)}}),100);
  }catch(e){toast('获取失败')}
};
window.loadPlaylistSongs=async function(id,name){
  try{const r=await fetch('/api/netease/playlist/detail?id='+id);const d=await r.json();
    const tracks=d.playlist?.tracks||[];
    if(!tracks.length){toast('歌单为空');return}
    playlist=[];cIdx=-1;
    tracks.forEach(t=>{playlist.push({id:t.id,name:t.name,artist:t.ar?.map(a=>a.name).join('/')||'?',dt:t.dt||0})});
    if(playlist.length>0){cIdx=0;playSong(0)}renderPl();
    document.getElementById('searchResults').style.display='none';
    document.getElementById('searchInput').value='';
    toast('已加载: '+name+' ('+playlist.length+'首)');
  }catch(e){toast('加载失败')}
};
window.loadLikedSongs=async function(){
  try{const r=await fetch('/api/netease/likelist/songs?limit=500');const d=await r.json();
    if(d.error){toast(d.error);return}
    const songs=d.songs||[];if(!songs.length){toast('没有喜欢的歌曲');return}
    playlist=[];cIdx=-1;
    songs.forEach(s=>{playlist.push({id:s.id,name:s.name,artist:s.ar?.map(a=>a.name).join('/')||'?',dt:s.dt||0})});
    if(playlist.length>0){cIdx=0;playSong(0)}renderPl();toast('我喜欢的音乐: '+playlist.length+' / '+d.total+' 首');
  }catch(e){toast('获取失败')}
};

// ===== UI =====
window.toggleImmersive=function(){
  document.body.classList.toggle('immersive');
  const isOn=document.body.classList.contains('immersive');
  document.getElementById('immerseBtn').textContent=isOn?'🖥':'🌌';
  document.getElementById('immerseBtn').title=isOn?'退出沉浸模式 (ESC)':'沉浸模式 (ESC)';
  orbitControls.enabled=isOn;
  orbitControls.target.set(0,0,0);
  if(!isOn){orbitControls.reset();cC.position.set(0,0.15,4.2);cC.lookAt(0,0,0)}
  setTimeout(resizeAll,600);
};
document.addEventListener('keydown',e=>{if(e.key==='Escape')window.toggleImmersive()});
window.toggleLeftPanel=function(){
  const lp=document.getElementById('leftPanel');const icon=document.getElementById('collapseIcon');
  if(lp.style.display==='none'){lp.style.display='';icon.textContent='◀'}else{lp.style.display='none';icon.textContent='▶'}
};
// Resize handle
(function(){
  const lp=document.getElementById('leftPanel');lp.style.position='relative';
  const h=document.createElement('div');h.id='resizeHandle';lp.appendChild(h);
  let rs=false,sx,sw;h.addEventListener('mousedown',e=>{rs=true;sx=e.clientX;sw=lp.offsetWidth;e.preventDefault()});
  document.addEventListener('mousemove',e=>{if(!rs)return;lp.style.width=Math.max(160,Math.min(600,sw+(e.clientX-sx)))+'px';resizeAll()});
  document.addEventListener('mouseup',()=>{rs=false});
})();

function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.className='toast show';setTimeout(()=>t.classList.remove('show'),2500)}

// ===== LYRICS =====
function parseLRC(lrcText){
  const lines=[];const re=/\[(\d{2}):(\d{2})\.(\d{2,3})\](.*)/g;let m;
  while((m=re.exec(lrcText))!==null){
    const min=parseInt(m[1]),sec=parseInt(m[2]),ms=parseInt(m[3].padEnd(3,'0'));
    const time=min*60+sec+ms/1000;
    const text=m[4].trim();
    if(text)lines.push({time,text});
  }
  return lines.sort((a,b)=>a.time-b.time);
}
async function fetchLyrics(songId){
  lyricsData=[];syncLyrics._lastIdx=-1;
  document.getElementById('lyricsStage').innerHTML='<div class="lyric-line" style="opacity:.2">⏳</div>';
  try{
    const d=await api('lyric',{id:songId});
    const lrc=d.lrc?.lyric||'';
    if(!lrc){document.getElementById('lyricsStage').innerHTML='<div class="lyric-line" style="opacity:.25">🎵 纯音乐</div>';return}
    lyricsData=parseLRC(lrc);
    renderLyrics(0);
  }catch(e){document.getElementById('lyricsStage').innerHTML='<div class="lyric-line" style="opacity:.25">暂无歌词</div>'}
}
// CSS lyrics — stable overlay approach

// CSS lyrics display functions
function renderLyrics(currentTime){
  let activeIdx=-1;
  for(let i=0;i<lyricsData.length;i++){if(lyricsData[i].time<=currentTime)activeIdx=i;else break}
  const stage=document.getElementById('lyricsStage');
  if(!lyricsData.length){stage.innerHTML='';return}
  const show=7,start=Math.max(0,activeIdx-Math.floor(show/2));
  let html='';
  for(let i=0;i<show;i++){
    const idx=start+i;if(idx>=lyricsData.length)break;
    let cls='lyric-line';
    if(idx===activeIdx)cls+=' active';else if(idx<activeIdx)cls+=' prev';
    html+=`<div class="${cls}">${lyricsData[idx].text}</div>`;
  }
  stage.innerHTML=html;
  requestAnimationFrame(()=>{
    const a=stage.querySelector('.active');
    if(a)a.scrollIntoView({block:'center',behavior:'smooth'});
  });
}
function syncLyrics(currentTime){
  if(!lyricsData.length)return;
  let idx=-1;
  for(let i=0;i<lyricsData.length;i++){if(lyricsData[i].time<=currentTime)idx=i;else break}
  if(idx>=0&&idx!==syncLyrics._lastIdx){syncLyrics._lastIdx=idx;renderLyrics(currentTime)}
}
syncLyrics._lastIdx=-1;
window.toggleLyrics=function(){
  lyricsVisible=!lyricsVisible;
  const ov=document.getElementById('lyricsOverlay');
  ov.style.display=lyricsVisible?'':'none';
  document.getElementById('lyricsToggle').classList.toggle('hidden-state',!lyricsVisible);
};
checkLogin();updatePb();updateRingProgress(0);resizeAll();
</script>
</body>
</html>
